{
  "git": {
    "diff_base": "head"
  },
  "show_wrap_guides": true,
  "git_panel": {
    "entry_primary_click_action": "file_diff",
    "collapse_untracked_diff": true,
    "tree_view": true,
    "group_by": "staging"
  },
  "buffer_font_family": "FiraCode Nerd Font Mono",
  "cli_default_open_behavior": "new_window",
  "proxy": "",
  "terminal": {
    "font_family": "FiraCode Nerd Font"
  },
  "project_panel": {
    "entry_spacing": "comfortable",
    "hide_gitignore": false,
    "git_status_indicator": true,
    "bold_folder_labels": false
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Zed (Default)"
  },
  "agent_servers": {
    "claude-acp": {
      "default_config_options": {
        "mode": "auto",
        "model": "default"
      },
      "type": "registry"
    }
  },
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Ayu Dark"
  }
}
