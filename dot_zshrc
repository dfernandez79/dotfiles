# ---------------------------------------------------------------------------
# Antidote
source $(brew --prefix)/opt/antidote/share/antidote/antidote.zsh
antidote load

# ---------------------------------------------------------------------------
# Startship Prompt
eval "$(starship init zsh)"

# ---------------------------------------------------------------------------
# FNM (replacement of NVM)
export FNM_COREPACK_ENABLED=true
eval "$(fnm env --use-on-cd)"

# ---------------------------------------------------------------------------
# Aliases

alias p=pnpm
alias pa='pnpm add'
alias pad='pnpm add -D'
alias pb='pnpm build'
alias pd='pnpm dev'
alias pin='pnpm install'
alias pln='pnpm lint'
alias pui='pnpm up -i -L'
alias prm='pnpm remove'
alias px='pnpm dlx'
alias pt='pnpm test'
alias ptc='pnpm test --coverage'
alias pp='pnpm why'

alias ls="lsd --group-dirs=first"
alias ll="ls -l --git '--date=+%Y-%m-%d %H:%M:%S'"
alias l="ll --blocks=permission,size,date,name"
alias la="l -A"

alias c="code ."
alias z="zed ."
alias yx="yarn dlx"

# removes the -v flag in the oh-my-zsh git plugin
alias gc="git commit"

# restore the run-help command (aliased to man for some reason)
unalias run-help
autoload run-help

# ---------------------------------------------------------------------------
# Worktrunk Integration

if command -v wt >/dev/null 2>&1; then
  wts() {
    wt switch --no-cd "$1" --execute=herdr -- worktree open --focus --branch "$1"
  }

  wtsc() {
    if [[ $# -ge 2 ]]; then
      wt switch --create --no-cd "$1" --base "$2" --execute=herdr -- worktree open --focus --branch "$1"
    else
      wt switch --create --no-cd "$1" --execute=herdr -- worktree open --focus --branch "$1"
    fi
  }

  _wtsc_completion() {
    local branches
    branches=($(git branch --format='%(refname:short)' 2>/dev/null))
    _describe 'branch' branches
  }

  # Add autocompletion to wts* functions
  compdef _wtsc_completion wts
  compdef _wtsc_completion wtsc

  eval "$(command wt config shell init zsh)"
fi

# ---------------------------------------------------------------------------

export EDITOR=nvim

# Initialize zsh completions
autoload -Uz compinit && compinit


